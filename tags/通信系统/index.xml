			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;strong&gt;5G 非透明模式&lt;/strong&gt;&lt;/td&gt;
					&lt;td&gt;直接/通过其他网络连接&lt;/td&gt;
					&lt;td&gt;灵活性高&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;strong&gt;5G 边缘计算&lt;/strong&gt;&lt;/td&gt;
					&lt;td&gt;业务就近分流&lt;/td&gt;
					&lt;td&gt;时间敏感、高带宽&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;strong&gt;SDN&lt;/strong&gt;&lt;/td&gt;
					&lt;td&gt;软件定义网络&lt;/td&gt;
					&lt;td&gt;控制转发分离&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;strong&gt;DAS&lt;/strong&gt;&lt;/td&gt;
