			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;strong&gt;WLAN&lt;/strong&gt;&lt;/td&gt;
					&lt;td&gt;无线局域网&lt;/td&gt;
					&lt;td&gt;WiFi&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;strong&gt;DDN&lt;/strong&gt;&lt;/td&gt;
					&lt;td&gt;数字数据网络&lt;/td&gt;
					&lt;td&gt;广域网&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;strong&gt;SDH&lt;/strong&gt;&lt;/td&gt;
